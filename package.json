{
  "name": "usdt-payment-service",
  "version": "0.1.0",
  "private": true,
  "description": "Самостоятельный сервис приёма USDT TRC20 и BEP20 через Alchemy.",
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "start": "npm run payments:start",
    "test": "tsx --test tests/payments-*.test.ts",
    "payments:start": "tsx src/payments/main.ts",
    "payments:admin": "tsx scripts/payments-admin.ts",
    "payments:check": "npm test && tsc --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@scure/bip32": "2.4.0",
    "express": "5.1.0",
    "tsx": "4.20.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/node": "22.18.12",
    "typescript": "5.9.3"
  }
}
